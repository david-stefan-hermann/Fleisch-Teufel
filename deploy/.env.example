# Copy into the Dockge stack's .env editor and fill in. Never commit real values.

# Database password (any long random string; used by both containers).
POSTGRES_PASSWORD=change-me-long-random

# Registration: the very first account can always be created. Afterwards keep this false
# (single-user operation) or set true to let family members register.
ALLOW_REGISTRATION=false
# Registrations per IP address and hour (spam protection).
# REGISTER_RATE_LIMIT=5

# Claude API key for the AI photo analysis (leave empty to disable the feature).
ANTHROPIC_API_KEY=
# Optional overrides
# AI_ENABLED=false turns the AI features off although a key is set (default: on with a key).
# AI_ENABLED=true
# Cheaper settings cost quality: AI_EFFORT=low saves about 30 % (one wrong pick in a small test),
# claude-sonnet-5-5 about 60 % (less reliable on dishes with many components).
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
# Reading food labels only copies printed values; a cheaper model does that fine.
# AI_LABEL_MODEL=claude-sonnet-5-5
# AI spending limit per account in USD (last 24 hours / last 30 days, failed calls included);
# above it the analysis answers "budget used up". 0 turns a limit off.
# AI_BUDGET_DAY_USD=5
# AI_BUDGET_MONTH_USD=50

# The assistant (floating button: speak or type what to log) runs whenever the AI is on. Recordings are
# transcribed by OpenAI: without this key the button only takes typed sentences.
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-transcribe
# Turning a sentence into diary operations: about 3 s and 0.1 cent per sentence with these defaults.
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_EFFORT=low

# Daily reminder (Web Push, Mehr → Erinnerung). Leave empty to not offer it. Generate a key pair once with
# `pnpm --filter @ft/api push:keys` (or `npx web-push generate-vapid-keys`) and keep it: a new pair
# silently ends every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services may use (defaults to mailto:OFF_CONTACT_EMAIL).
# VAPID_SUBJECT=mailto:you@example.com

# Contact e-mail sent in the Open Food Facts User-Agent (their API etiquette).
OFF_CONTACT_EMAIL=you@example.com

# info | debug | warn | error
LOG_LEVEL=info
