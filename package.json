{
  "name": "fleisch-teufel",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first nutrition tracker PWA (MyFitnessPal-style) with self-hosted sync and AI photo logging.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ft/api --filter @ft/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "bls:import": "pnpm --filter @ft/bls-import start",
    "e2e": "pnpm --filter @ft/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
